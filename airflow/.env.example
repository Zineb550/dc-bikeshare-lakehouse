# Copy to airflow/.env (gitignored). Astro loads it into every Airflow container.
# Keys come from: aws iam create-access-key --user-name dc-bikeshare-airflow
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

BIKESHARE_LAKE_BUCKET=dc-bikeshare-lake-<account-id>
BIKESHARE_INGEST_FUNCTION=dc-bikeshare-ingest
BIKESHARE_ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:<account-id>:bikeshare-alerts
