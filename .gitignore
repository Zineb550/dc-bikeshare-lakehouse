# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Secrets and local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# .terraform.lock.hcl IS committed (pins provider versions)

# --- dbt ---
target/
dbt_packages/
logs/
.user.yml

# --- Airflow / Astro (the Astro project adds its own .gitignore too) ---
airflow/.astro/
airflow/airflow_settings.yaml

# --- Data files: this repo holds code only, never data ---
data/
*.zip
*.csv
*.parquet
*.json.gz
check_output.txt

# --- Metabase local state ---
metabase-data/
*.db.mv.db
*.db.trace.db

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
